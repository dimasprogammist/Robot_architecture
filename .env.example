# Скопируйте в `.env` в корне репозитория или в `backend/.env`.
# Секреты не коммитьте.

# Публичный адрес приложения (без завершающего слэша). Попадает в письма сброса пароля.
# Для локальной разработки: http://localhost:5173
# Не подставляйте localhost, если пользователи заходят с других машин.
APP_BASE_URL=http://localhost:5173

# Пусто: при SMTP_HOST используется smtp, иначе сброс пароля вернёт 503 (без ложного «письмо отправлено»).
# file — только локальная запись .eml в MAIL_DIR, и только если SMTP_HOST не задан.
# smtp — обязательная реальная отправка; без SMTP_HOST конфигурация считается неполной.
MAIL_BACKEND=
MAIL_DIR=

# SMTP для продакшена. Не оставляйте пароль в репозитории.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
# true для SMTPS (обычно порт 465). Иначе используется STARTTLS на 587.
SMTP_SSL=false
SMTP_STARTTLS=true
