# Публичный адрес приложения (без завершающего слэша). Используется в письмах сброса пароля.
# Не подставляйте localhost, если пользователи заходят с других машин.
APP_BASE_URL=https://example.com

# SMTP. Без SMTP_HOST сброс пароля возвращает ошибку администратору и не показывает ссылку в UI.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# true для SMTPS (обычно порт 465). Иначе используется STARTTLS на 587.
SMTP_SSL=false
SMTP_STARTTLS=true
